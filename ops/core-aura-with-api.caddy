core-aura.coreeye.in {
    encode zstd gzip
    header Cache-Control "no-cache"
    @packfiles path /packs/*
    header @packfiles Access-Control-Allow-Origin "*"
    handle /packs/uploads/* {
        reverse_proxy 127.0.0.1:8793
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:8793
    }
    handle {
        root * /var/www/core-aura/current
        file_server
    }
}
