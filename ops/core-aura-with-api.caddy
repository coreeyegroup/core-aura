core-aura.coreeye.in {
    handle_path /android/* {
        root * /var/www/core-aura/android
        header Access-Control-Allow-Origin "*"
        header Cache-Control "no-store"
        @androidApk path *.apk
        header @androidApk Content-Type application/vnd.android.package-archive
        header @androidApk Content-Disposition attachment
        file_server
    }
    encode zstd gzip
    header Cache-Control "no-cache"
    @packfiles path /packs/*
    header @packfiles Access-Control-Allow-Origin "*"
    handle /packs/uploads/* {
        reverse_proxy 127.0.0.1:8793
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:8793
    }
    handle {
        root * /var/www/core-aura/current
        file_server
    }
}
